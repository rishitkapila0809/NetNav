# Browser-visible configuration (never put secrets in VITE_ variables)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_MEASUREMENT_SERVER_URL=http://localhost:3001

# Server-only PostgreSQL connection string. Keep the real value in .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
